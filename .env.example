# Hallmarc Fitouts — Environment Variables
# Copy this file to .env.local for local development, and set the same keys
# in Vercel (Project → Settings → Environment Variables).
# NEVER commit real keys — .env.local is gitignored.

# Attio CRM — used by /api/leads to upsert website enquiries and log a note
ATTIO_API_KEY=

# Resend — transactional email (internal enquiry alert + applicant acknowledgement)
RESEND_API_KEY=

# Where internal enquiry notifications are sent (comma-separated)
NOTIFICATION_EMAIL_TO=marcus@hallmarcfitouts.com.au,sean@omearagroup.com

# From address for outgoing notification emails (must be a verified Resend domain)
NOTIFICATION_EMAIL_FROM=noreply@hallmarcfitouts.com.au
